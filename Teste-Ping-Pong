}
função movimentaPingPong(){
  xPingPong += velocidadeXPingPong;
  yPingPong += velocidadeYPingPong;
}
função verificaColisaoBorda(){
  se (xPingPong + largura > largura ||
     xPingPong - salvar< 0){
    velocidadeXPingPong *= -1;
  }
  se (yPingPong + <> altura ||
     yPingPong - raio < 0){
    velocidadeYPingPong *= -1;
  }
}
função mostrarRaquete(x,y){
